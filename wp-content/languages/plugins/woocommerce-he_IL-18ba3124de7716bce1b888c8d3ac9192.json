\u05e6\u05d9\u05d2 \u05d3\u05d1\u05e8\u05d9\u05dd \u05e9\u05db\u05d3\u05d0\u05d9 \u05dc\u05e2\u05e9\u05d5\u05ea \u05d1\u05e9\u05dc\u05d1 \u05d4\u05d1\u05d0"],"Additional payment options":["\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05ea\u05e9\u05dc\u05d5\u05dd \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"],"Local Partner":["\u05e9\u05d5\u05ea\u05e3 \u05de\u05e7\u05d5\u05de\u05d9"],"Configure your %(title)s account":["\u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05e9\u05dc\u05da \u05d1-%(title)s"],"No thanks, I'll set up manually":["\u05dc\u05d0 \u05ea\u05d5\u05d3\u05d4, \u05d0\u05e0\u05d9 \u05d0\u05d1\u05e6\u05e2 \u05d0\u05ea \u05d4\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9"],"I don't charge sales tax":["\u05d0\u05e0\u05d9 \u05dc\u05d0 \u05d2\u05d5\u05d1\u05d4 \u05de\u05e1 \u05de\u05db\u05d9\u05e8\u05d5\u05ea"],"Set up manually":["\u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9"],"Would you like to add the following paid features to your store now?":["\u05d4\u05d0\u05dd \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05db\u05e2\u05ea \u05d0\u05ea \u05d4\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea \u05d1\u05ea\u05e9\u05dc\u05d5\u05dd \u05dc\u05d7\u05e0\u05d5\u05ea \u05e9\u05dc\u05da?"],"WooCommerce Home":["\u05e2\u05de\u05d5\u05d3 \u05d4\u05d1\u05d9\u05ea \u05e9\u05dc WooCommerce"],"Task dismissed":["\u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d1\u05d5\u05d8\u05dc\u05d4"],"My business doesn't charge sales tax":["\u05d4\u05e2\u05e1\u05e7 \u05e9\u05dc\u05d9 \u05d2\u05d5\u05d1\u05d4 \u05de\u05e1 \u05de\u05db\u05d9\u05e8\u05d5\u05ea"],"Abort":["\u05dc\u05d1\u05d8\u05dc"],"Review your shipping options":["\u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"],"Hide this":["\u05dc\u05d4\u05e1\u05ea\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05d9\u05d3\u05e2"],"Undo":["\u05d1\u05d9\u05d8\u05d5\u05dc"],"Marketplace":["Marketplace"],"Installed marketing extensions":["\u05d4\u05e8\u05d7\u05d1\u05d5\u05ea \u05e9\u05d9\u05d5\u05d5\u05e7 \u05de\u05d5\u05ea\u05e7\u05e0\u05d5\u05ea"],"Finish setup":["\u05dc\u05d4\u05e9\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4"],"There was an error connecting to WooPayments. Please try again or connect later in store settings.":["\u05d0\u05d9\u05e8\u05e2\u05d4 \u05e9\u05d2\u05d9\u05d0\u05d4 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea \u05d0\u05dc WooPayments. \u05e0\u05d9\u05ea\u05df \u05dc\u05e0\u05e1\u05d5\u05ea \u05e9\u05d5\u05d1 \u05d0\u05d5 \u05dc\u05d4\u05ea\u05d7\u05d1\u05e8 \u05de\u05d0\u05d5\u05d7\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05d7\u05e0\u05d5\u05ea."],"These details are required to receive payments via bank transfer":["\u05d4\u05e4\u05e8\u05d8\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4 \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05e7\u05d1\u05dc \u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d4\u05e2\u05d1\u05e8\u05d4 \u05d1\u05e0\u05e7\u05d0\u05d9\u05ea"],"Add your bank details":["\u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05d0\u05ea \u05e4\u05e8\u05d8\u05d9 \u05d4\u05d1\u05e0\u05e7 \u05e9\u05dc\u05da"],"Direct bank transfer details added successfully":["\u05d4\u05e4\u05e8\u05d8\u05d9\u05dd \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05e2\u05d1\u05e8\u05d4 \u05d1\u05e0\u05e7\u05d0\u05d9\u05ea \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e0\u05d5\u05e1\u05e4\u05d5 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4"],"Please enter an account number or IBAN":["\u05d9\u05e9 \u05dc\u05d4\u05d6\u05d9\u05df \u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05df \u05d0\u05d5 \u05de\u05e1\u05e4\u05e8 IBAN"],"There was a problem saving your payment settings":["\u05d0\u05d9\u05e8\u05e2\u05d4 \u05d1\u05e2\u05d9\u05d4 \u05d1\u05e9\u05de\u05d9\u05e8\u05ea \u0